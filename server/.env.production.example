# Production environment template for the SeatMate API.
# Copy to .env on the production host (or set these as real environment
# variables / secrets in your hosting platform) and fill in real values.
# Never commit an actual .env file.

NODE_ENV=production
PORT=5000

# The exact origin the frontend is served from in production (no trailing
# slash, must match exactly — this drives CORS and is required for cookies
# to work cross-site). Example: https://app.seatmate.example
CLIENT_ORIGIN=https://your-frontend-domain.example

# A real MongoDB deployment (e.g. MongoDB Atlas). Must be a replica set —
# the swap-accept flow uses multi-document transactions, which a standalone
# mongod does not support. A managed Atlas cluster is a replica set by
# default, so this is usually automatic.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/seatmate?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this invalidates every existing session — treat it as a secret,
# never reuse the development value.
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=seatmate_token

# Same values as development by default — tune down RATE_LIMIT_MAX if the
# deployment sits behind a single small instance and you want tighter
# headroom against abusive traffic.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

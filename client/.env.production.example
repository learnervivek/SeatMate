# Production environment template for the SeatMate frontend build.
# Vite inlines these at build time (`npm run build`) — there is no runtime
# environment for a static frontend bundle, so the build must be re-run
# whenever these change.

# The deployed API's origin, including the /api prefix.
VITE_API_URL=https://your-backend-domain.example/api

# The deployed API's origin for the Socket.IO connection (no /api suffix —
# Socket.IO handshakes at the server root).
VITE_SOCKET_URL=https://your-backend-domain.example
